<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Flavour Town{% endblock %}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <style>
    :root { --ink:#24221f; --cream:#f8f6f1; --orange:#e36b3d; --sage:#dce7dc; }
    body { background:var(--cream); color:var(--ink); font-family:"DM Sans",sans-serif; }
    h1,h2,h3,.brand { font-family:"Playfair Display",serif; }
    .navbar { background:#fff; border-bottom:1px solid #ebe7df; }
    .brand { color:var(--ink); font-size:1.55rem; text-decoration:none; }
    .brand span { color:var(--orange); }
    .hero { background:var(--sage); border-radius:1.5rem; min-height:340px; overflow:hidden; }
    .hero-art { font-size:10rem; filter:drop-shadow(0 18px 12px rgba(0,0,0,.1)); }
    .food-card { border:0; border-radius:1rem; overflow:hidden; box-shadow:0 6px 24px rgba(36,34,31,.06); height:100%; }
    .food-card img { height:190px; object-fit:cover; }
    .rating { color:#e36b3d; letter-spacing:1px; }
    .btn-primary { --bs-btn-bg:var(--orange); --bs-btn-border-color:var(--orange); --bs-btn-hover-bg:#c7552c; --bs-btn-hover-border-color:#c7552c; }
    .badge-soft { background:#f9e3d9; color:#a8411e; }
    .modal-content, .table-responsive { border:0; border-radius:1rem; }
    .section-label { color:var(--orange); font-weight:700; letter-spacing:.12em; text-transform:uppercase; font-size:.75rem; }
    .wysiwyg { min-height:180px; }
    .food-description strong { font-weight:700; }
  </style>
</head>
<body>
<nav class="navbar sticky-top">
  <div class="container py-2">
    <a class="brand" href="./">Flavour <span>Town</span></a>
    <div class="d-flex align-items-center gap-3">
      {% if user %}
        <span class="small text-muted d-none d-md-inline">Hi, {{ user.name }}</span>
        <span class="badge badge-soft text-capitalize">{{ user.role }}</span>
        {% if user.role in ['consumer', 'superadmin'] %}<a class="btn btn-sm btn-outline-dark" href="?page=ratings">My ratings</a>{% endif %}
        {% if user.role in ['admin', 'superadmin'] %}<a class="btn btn-sm btn-outline-dark" href="?page=users">Users</a>{% endif %}
        <button class="btn btn-sm btn-outline-dark ajax-action" data-action="logout">Sign out</button>
      {% else %}
        <button class="btn btn-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#authModal" data-mode="login">Sign in</button>
        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#authModal" data-mode="register">Join us</button>
      {% endif %}
    </div>
  </div>
</nav>
<main class="container py-4 py-lg-5">{% block content %}{% endblock %}</main>
<div class="toast-container position-fixed bottom-0 end-0 p-3"><div id="toast" class="toast"><div class="toast-body"></div></div></div>
<div class="modal fade" id="authModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-body p-4"><h2 id="authTitle">Welcome back</h2><p class="text-muted">Sign in to share your taste.</p><form id="authForm" novalidate><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="mode" value="login"><div id="nameField" class="mb-3 d-none"><label class="form-label">Name</label><input class="form-control" name="name" autocomplete="name"></div><div class="mb-3"><label class="form-label">Email</label><input class="form-control" type="email" name="email" autocomplete="email"></div><div class="mb-3"><label class="form-label">Password</label><input class="form-control" type="password" name="password" minlength="6" autocomplete="current-password"></div><div id="authError" class="alert alert-danger d-none" role="alert"></div><button class="btn btn-primary w-100">Continue</button></form><button id="switchAuth" class="btn btn-link w-100 mt-2">New here? Create an account</button></div></div></div></div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
const csrf = '{{ csrf }}';
const authForm = document.getElementById('authForm');
const authError = document.getElementById('authError');
const setAuthMode = mode => { const register = mode === 'register'; authForm.mode.value = mode; document.getElementById('authTitle').textContent = register ? 'Join us' : 'Welcome back'; document.getElementById('nameField').classList.toggle('d-none', !register); authForm.name.required = register; authForm.password.autocomplete = register ? 'new-password' : 'current-password'; document.getElementById('switchAuth').textContent = register ? 'Already have an account? Sign in' : 'New here? Create an account'; authError.textContent = ''; authError.classList.add('d-none'); };
document.querySelectorAll('[data-mode]').forEach(button => button.addEventListener('click', () => setAuthMode(button.dataset.mode)));
const toast = (message, error = false) => { const el = document.getElementById('toast'); el.querySelector('.toast-body').textContent = message; el.classList.toggle('text-bg-danger', error); bootstrap.Toast.getOrCreateInstance(el).show(); };
const send = async (action, data) => { const body = data instanceof FormData ? data : new URLSearchParams(data); body.set('csrf', csrf); const response = await fetch('?action=' + action, {method:'POST', body}); const result = await response.json(); if (!response.ok) throw new Error(result.error || 'Something went wrong.'); return result; };
document.querySelectorAll('.ajax-action').forEach(button => button.addEventListener('click', async () => { if (button.dataset.confirm && !window.confirm(button.dataset.confirm)) return; try { const data = {...button.dataset}; delete data.action; delete data.confirm; await send(button.dataset.action, data); location.href = './'; } catch (error) { toast(error.message, true); } }));
document.getElementById('switchAuth')?.addEventListener('click', () => setAuthMode(authForm.mode.value === 'login' ? 'register' : 'login'));
authForm?.addEventListener('submit', async event => { event.preventDefault(); const form = event.target; const register = form.mode.value === 'register'; const name = form.name.value.trim(); const email = form.email.value.trim(); const password = form.password.value; authError.classList.add('d-none'); authError.textContent = ''; if ((register && !name) || !email || !email.includes('@') || !email.includes('.') || !password || password.length < 6) { authError.textContent = register && !name ? 'Please enter your name.' : !email ? 'Please enter your email address.' : !email.includes('@') || !email.includes('.') ? 'Please enter a valid email address.' : !password ? 'Please enter your password.' : 'Password must be at least 6 characters.'; authError.classList.remove('d-none'); return; } try { const result = await send(form.mode.value, Object.fromEntries(new FormData(form))); location.href = result.redirect; } catch (error) { authError.textContent = error.message; authError.classList.remove('d-none'); } });
document.querySelectorAll('.ajax-form').forEach(form => form.addEventListener('submit', async event => { event.preventDefault(); try { const data = new FormData(form); if (form.editor) data.set('description', form.editor.value); const result = await send(form.dataset.action, data); location.href = result.redirect || window.location.href; } catch (error) { toast(error.message, true); } }));
</script>
{% block scripts %}{% endblock %}
</body>
</html>
