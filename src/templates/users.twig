{% extends "base.twig" %}
{% block title %}User management | Flavour Town{% endblock %}
{% block content %}
<a href="./" class="text-decoration-none text-muted">← Back to menu</a>
<div class="section-label mt-4">Administration</div><h1 class="mb-4">User management</h1><div class="table-responsive bg-white shadow-sm"><table class="table align-middle mb-0"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Joined</th></tr></thead><tbody>
{% for member in users %}<tr><td>{{ member.name }}</td><td>{{ member.email }}</td><td>{% if user.role == 'superadmin' and member.role != 'superadmin' %}<select class="form-select form-select-sm user-role" data-user-id="{{ member.id }}">{% for role in ['consumer','manager','admin'] %}<option {% if role == member.role %}selected{% endif %}>{{ role }}</option>{% endfor %}</select>{% elseif user.role == 'admin' and member.role in ['consumer','manager'] %}<select class="form-select form-select-sm user-role" data-user-id="{{ member.id }}">{% for role in ['consumer','manager'] %}<option {% if role == member.role %}selected{% endif %}>{{ role }}</option>{% endfor %}</select>{% else %}<span class="text-capitalize">{{ member.role }}</span>{% endif %}</td><td class="text-muted">{{ member.created_at|date('M j, Y') }}</td></tr>{% endfor %}
</tbody></table></div>
{% endblock %}
{% block scripts %}<script>document.querySelectorAll('.user-role').forEach(select => select.addEventListener('change', async () => { try { const result = await send('user-role', {user_id:select.dataset.userId, role:select.value}); toast(result.message); } catch (error) { toast(error.message, true); } }));</script>{% endblock %}
