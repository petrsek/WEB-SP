<section>
  <div class="section-label">{{ title|default('Ratings') }}</div>
  {% if title|default('') != 'Ratings' %}<h2 class="mb-4">Ratings</h2>{% endif %}
  {% for rating in ratings %}
    <div class="bg-white rounded-3 p-3 mb-3 shadow-sm">
      <div class="d-flex justify-content-between">
        {% if showFood|default(false) %}<a class="fw-semibold text-decoration-none text-dark" href="?page=food&id={{ rating.food_id }}">{{ rating.food_name }}</a>{% else %}<strong>{{ rating.user_name }}</strong>{% endif %}
        <span class="rating">{{ rating.score }}/5</span>
      </div>
      <p class="mb-0 mt-2 text-muted">{{ rating.comment ?: 'No comment.' }}</p>
    </div>
  {% else %}
    <p class="text-muted">{{ emptyMessage|default('No ratings yet.') }}</p>
  {% endfor %}
</section>
