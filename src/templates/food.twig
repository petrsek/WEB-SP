{% extends "base.twig" %}
{% block title %}{{ food.name }} | Flavour Town{% endblock %}
{% block content %}
<a href="./" class="text-decoration-none text-muted">← Back to menu</a>
<div class="row g-5 mt-1 mb-5"><div class="col-lg-6"><img class="img-fluid rounded-4 shadow-sm w-100" src="{{ food.image_url ?: 'https://images.unsplash.com/photo-1547592180-85f173990554?w=800' }}" alt="{{ food.name }}"></div><div class="col-lg-6 d-flex flex-column justify-content-center"><span class="badge badge-soft align-self-start mb-3">{{ food.category }}</span><h1>{{ food.name }}</h1><p class="lead text-muted">{{ food.description }}</p><p class="h4">€{{ food.price|number_format(2) }}</p><p class="rating fs-4">★★★★★ <span class="text-dark fs-6">{{ food.average_rating ?: 'No rating yet' }} / 5 ({{ food.rating_count }})</span></p>{% if user and user.role in ['consumer', 'superadmin'] %}<a class="btn btn-primary align-self-start" href="?page=rating&food_id={{ food.id }}">Rate this dish</a>{% endif %}{% if user and user.role in ['manager', 'superadmin'] %}<a class="btn btn-outline-dark align-self-start" href="?page=food-edit&id={{ food.id }}">Edit menu item</a>{% endif %}</div></div>
<section><div class="section-label">Community feedback</div><h2 class="mb-4">Ratings</h2>{% for rating in ratings %}<div class="bg-white rounded-3 p-3 mb-3 shadow-sm"><div class="d-flex justify-content-between"><strong>{{ rating.user_name }}</strong><span class="rating">{{ rating.score }}/5</span></div><p class="mb-0 mt-2 text-muted">{{ rating.comment ?: 'No comment.' }}</p></div>{% else %}<p class="text-muted">No ratings yet.</p>{% endfor %}</section>
{% endblock %}
