{% extends "base.twig" %}
{% block title %}{{ food.name }} | Flavour Town{% endblock %}
{% block content %}
<a href="./" class="text-decoration-none text-muted">← Back to menu</a>
<div class="row g-5 mt-1 mb-5"><div class="col-lg-6"><img class="img-fluid rounded-4 shadow-sm w-100" src="{{ food.image_url ?: 'https://images.unsplash.com/photo-1547592180-85f173990554?w=800' }}" alt="{{ food.name }}"></div><div class="col-lg-6 d-flex flex-column justify-content-center"><span class="badge badge-soft align-self-start mb-3">{{ food.category }}</span><h1>{{ food.name }}</h1><div class="food-description lead text-muted">{{ food.description|raw }}</div><p class="h4">€{{ food.price|number_format(2) }}</p><p class="rating fs-4" aria-label="{{ food.average_rating }} out of 5 stars">{% for star in 1..5 %}{{ food.average_rating >= star ? '★' : '☆' }}{% endfor %} <span class="text-dark fs-6">{{ food.average_rating ?: 'No rating yet' }} / 5 ({{ food.rating_count }})</span></p><div class="d-flex gap-2">{% if user and user.role in ['consumer', 'superadmin'] %}<a class="btn btn-primary" href="?page=rating&food_id={{ food.id }}">Rate this dish</a>{% endif %}{% if user and user.role in ['manager', 'admin', 'superadmin'] %}<a class="btn btn-outline-dark" href="?page=food-edit&id={{ food.id }}">Edit menu item</a><button class="btn btn-outline-danger ajax-action" data-action="food-delete" data-food_id="{{ food.id }}" data-confirm="Remove this menu item and all its ratings?">Delete menu item</button>{% endif %}</div></div></div>
{% include 'rating-list.twig' with {title: 'Community feedback', ratings: ratings, emptyMessage: 'No ratings yet.'} %}
{% endblock %}
