{% extends "base.twig" %}
{% block title %}Flavour Town | Menu{% endblock %}
{% block content %}
<section class="hero row align-items-center p-4 p-md-5 mb-5">
  <div class="col-lg-7"><div class="section-label mb-3">Good food. Honest opinions.</div><h1 class="display-4 mb-3">Find your next favorite dish.</h1><p class="lead mb-4">Explore our menu, read community ratings, and discover something worth coming back for.</p><a href="#menu" class="btn btn-primary px-4">Explore the menu</a></div>
  <div class="col-lg-5 text-center hero-art" aria-hidden="true">🍝</div>
</section>
<section id="menu"><div class="section-label">From our kitchen</div><div class="d-flex align-items-center justify-content-between gap-3 mb-4"><h2 class="mb-0">Menu overview</h2>{% if user and user.role in ['manager', 'admin', 'superadmin'] %}<a class="btn btn-sm btn-primary" href="?page=food-edit">Add food</a>{% endif %}</div><div class="row g-4">
{% for food in foods %}<div class="col-md-6 col-lg-4"><article class="card food-card"><img src="{{ food.image_url ?: '?image=default.png' }}" alt="{{ food.name }}" loading="lazy"><div class="card-body d-flex flex-column p-4"><div class="d-flex justify-content-between gap-2"><span class="badge badge-soft mb-2">{{ food.category }}</span><span class="small text-muted">€{{ food.price|number_format(2) }}</span></div><h3 class="h4">{{ food.name }}</h3><div class="text-muted small flex-grow-1">{{ food.description|raw }}</div><div class="d-flex justify-content-between"><span class="rating" aria-label="{{ food.average_rating }} out of 5 stars">{% for star in 1..5 %}{{ food.average_rating >= star ? '★' : '☆' }}{% endfor %} <small class="text-muted">({{ food.rating_count }})</small></span><strong>{{ food.average_rating ?: '—' }}<small class="text-muted"> / 5</small></strong></div><a class="btn btn-sm btn-outline-dark mt-3" href="?page=food&id={{ food.id }}">View dish</a></div></article></div>{% else %}<p class="text-muted">The menu is being prepared.</p>{% endfor %}
</div></section>
{% endblock %}