{% extends "base.twig" %}
{% block title %}Edit {{ food.name }} | Flavour Town{% endblock %}
{% block content %}
<a href="?page=food&id={{ food.id }}" class="text-decoration-none text-muted">← Back to dish</a>
<div class="row justify-content-center mt-4"><div class="col-lg-7"><div class="bg-white rounded-4 shadow-sm p-4 p-md-5"><div class="section-label">Menu management</div><h1>Edit menu item</h1><form class="ajax-form" data-action="food-save"><input type="hidden" name="food_id" value="{{ food.id }}"><div class="mb-3"><label class="form-label">Name</label><input class="form-control" name="name" value="{{ food.name }}" required></div><div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" name="description" required>{{ food.description }}</textarea></div><div class="row"><div class="col-md-7 mb-3"><label class="form-label">Category</label><input class="form-control" name="category" value="{{ food.category }}" required></div><div class="col-md-5 mb-3"><label class="form-label">Price</label><input class="form-control" name="price" type="number" step=".01" min=".01" value="{{ food.price }}" required></div></div><div class="mb-4"><label class="form-label">Image URL</label><input class="form-control" name="image_url" type="url" value="{{ food.image_url }}"></div><button class="btn btn-primary">Save changes</button></form></div></div></div>
{% endblock %}
